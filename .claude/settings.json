{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(node:*)",
      "Bash(npx playwright-cli:*)",
      "Bash(lsof:*)",
      "Read(//tmp/**)",
      "Bash(nginx -t:*)",
      "Bash(caddy version:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(git:*)",
      "Bash(mkdir:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); if echo \"$input\" | grep -qE '\"file_path\"\\s*:\\s*\"[^\"]*\\.env'; then echo 'Blocked: .env files are protected. Do not edit secrets or credentials.' >&2; exit 2; fi"
          }
        ]
      }
    ],
    "PostToolUse": []
  }
}
