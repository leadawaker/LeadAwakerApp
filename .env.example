# Lead Awaker CRM: environment variables
# Copy to .env and fill in. Names only here, never commit real values.
# Most integrations are optional: leave a block empty and that feature stays off.

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Express port (the Vite dev middleware is served from the same port)
PORT=5000
# Postgres connection; all CRM tables live in schema p2mxx34fvbf3ll6
DATABASE_URL=
# Signs the session cookie
SESSION_SECRET=
# Cookie domain shared by app., api. and the marketing site (e.g. .leadawaker.com)
COOKIE_DOMAIN=
# Allowed browser origins for the API
CORS_ORIGIN=
# Public URLs used in links, emails and OAuth redirects
APP_URL=
FRONTEND_URL=
PASSWORD_RESET_BASE_URL=
# Set to run the API alone, without the Vite dev middleware
STANDALONE_API=
# Set to 1 to skip pollers and schedulers (handy on a second dev machine)
DISABLE_BACKGROUND_JOBS=

# ── Internal services ───────────────────────────────────────────────────
# Shared key for server-to-server calls: automations engine, booking Worker, caldiy
INTERNAL_API_KEY=
# Python automations engine (LeadAwakerAutomations repo)
ENGINE_URL=http://localhost:8100
ENGINE_STATUS_WEBHOOK_URL=
ENGINE_INBOUND_WEBHOOK_URL=

# ── Machine paths (defaults are Gabriel's Pi, see server/paths.ts) ──────
# Home folder for the claude/gog CLIs and default parent of the paths below
AGENT_HOME=
APP_DIR=
AUTOMATIONS_DIR=
AUTOMATIONS_PYTHON=
CALDIY_DIR=
CLAUDE_BIN=
GOG_BIN=
INVOICES_DIR=
EXPENSES_DIR=

# ── Encryption keys for stored secrets ──────────────────────────────────
# Encrypts per-account channel credentials (WhatsApp, Instagram, ...)
CHANNEL_SECRETS_KEY=
# Encrypts stored AI agent credentials
CLAUDE_ENCRYPTION_KEY=
# Encrypt stored Google/Microsoft calendar and Gmail tokens
CALENDAR_TOKEN_SECRET=
GMAIL_TOKEN_SECRET=

# ── AI providers ────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Older name still read in a few places; set it to the same key
OPEN_AI_API_KEY=
# Separate key with tight limits for the public website voice demo
OPENAI_PUBLIC_DEMO_API_KEY=
# OpenAI Realtime SIP project for phone calls
OPENAI_SIP_PROJECT_ID=
GROQ_API_KEY=
HEYGEN_API_KEY=
# Comma-separated Firecrawl keys for website scraping
FIRECRAWL_API_KEYS=
# claude | openai
COMPANY_ENRICH_PROVIDER=
ENABLE_CONTACT_DISCOVERY_IN_COMPANY_ENRICH=
# LinkedIn enrichment reads RAPIDAPI_KEY_1 ... RAPIDAPI_KEY_n
RAPIDAPI_KEY_1=

# ── Email ───────────────────────────────────────────────────────────────
# resend | smtp
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where email images and the logo are served from
EMAIL_ASSET_BASE=
EMAIL_LOGO_URL=

# ── Google and Microsoft (login, Gmail, calendar, reviews) ──────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_REVIEWS_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI=
# Set to 1 to use mock Google reviews instead of the API
REVIEWS_MOCK=
REVIEWS_POLL_INTERVAL_MS=

# ── Telephony ───────────────────────────────────────────────────────────
TELNYX_API_KEY=
TELNYX_DIRECT_CONNECTION_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_APP_SID=
TWILIO_NL_NUMBER=
TWILIO_BR_NUMBER=
TWILIO_WEBHOOK_BASE_URL=

# ── WhatsApp and Meta ───────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Set to 1 to send real Instagram DMs (off = dry run)
INSTAGRAM_DM_LIVE=
# Public base URL the social publisher serves media from
SOCIAL_MEDIA_BASE_URL=

# ── Notifications ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_FOUNDER_CHAT_ID=
SUPPORT_CHAT_TELEGRAM_WEBHOOK_URL=
# Web push (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Login security ──────────────────────────────────────────────────────
# Passkeys: RP ID is the registrable domain, origins are comma-separated
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGINS=
# Cloudflare Turnstile on public forms
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Demos, booking and other integrations ───────────────────────────────
# Campaign ids of the demo personas, comma-separated
DEMO_PERSONA_CAMPAIGN_IDS=
# Origin of the public demo pages (the marketing site)
DEMO_PAGE_ORIGIN=
# Cloudflare Tunnel CNAME that client booking domains point at
CF_TUNNEL_CNAME=
# E-signing for contracts
SIGNWELL_API_KEY=
# Webhook secret for the Topa integration
TOPA_WEBHOOK_SECRET=

# ── Client build (Vite, exposed to the browser) ─────────────────────────
# API base for the deployed frontend (empty = same origin)
VITE_API_URL=
VITE_VOICE_ENGINE_URL=
VITE_META_APP_ID=
VITE_META_WHATSAPP_CONFIG_ID=
VITE_META_WHATSAPP_COEX_CONFIG_ID=
VITE_WHATSAPP_PARTNER_SOLUTION_ID=
VITE_TELEGRAM_DEMO_BOT_USERNAME=

# ── Scripts in script/ ──────────────────────────────────────────────────
# Login used by the seed scripts (script/seed-leads.cjs, seed-campaign-metrics.cjs)
LA_LOGIN_EMAIL=
LA_LOGIN_PASSWORD=
